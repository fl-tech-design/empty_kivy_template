# pop_auth_user.kv
# User authentication popup dialog

# Imports
#: import constants constants

<Pop_Auth_User@Popup>:
    # Popup configuration
    auto_dismiss: False  # Prevent closing by clicking outside
    size_hint: (None, None)
    width: "500dp"
    height: "300dp"
    background_color: constants.APP_BG
    title_size: '23sp'
    title_font: constants.DIR_FONTS + "cmunobx.ttf"
    title_color: constants.POP_TITLE
    separator_color: constants.POP_SEPARATOR
    separator_height: '4dp'

    # Main layout container
    ColBoxLayout_1:
        orientation: 'vertical'
        padding: 2
        spacing: 4
        
        # Content container
        ColBoxLayout_4:
            orientation: 'vertical'
            padding: 2
            spacing: 2
            
            # Information label section
            ColBoxLayout_2:
                size_hint: (1, None)
                height: 80
                Lbl_Small:
                    id: lab_inf_create_user
                    text_size: (self.width - 40, None)
                    halign: 'center'
                    valign: 'middle'
                    font_size: "25dp"
            
            # Username input field
            ColBoxLayout_2:
                size_hint_y: None
                height: "40dp"
                TextInput:
                    id: inp_username
                    multiline: False
                    font_size: "23dp"
            
            # Password input with visibility toggle
            ColBoxLayout_2:
                size_hint_y: None
                height: "42dp"
                ColBoxLayout_2:
                    TextInput:
                        id: inp_passwd
                        password: True  # Initially masked
                        multiline: False
                        font_size: "23dp"
                        on_text_validate: root.but_confirm_released()  # Enter key confirmation
                    
                    # Password visibility toggle
                    ToggleButton:
                        canvas.before:
                            Color: 
                                rgba: [0.2, 0.2, 0.2, 1]
                            Rectangle: 
                                size: self.size
                                pos: self.pos
                                source: constants.DIR_IMGS + "eye_down.png"
                        size_hint_x: None
                        width: "50dp"
                        on_release: inp_passwd.password = not self.state == "down"
            
            # Action buttons section
            ColBoxLayout_1:
                orientation: "vertical"
                padding: 2
                size_hint_y: None
                height: "40dp"
                ColBoxLayout_4:
                    padding: 2
                    spacing: 8
                    
                    # Confirm button
                    ColBoxLayout_2:
                        Btn_Clear_1:
                            id: but_confirm
                            on_release: root.but_confirm_released()
                    
                    # Close button
                    ColBoxLayout_2:
                        Btn_Clear_1:
                            id: but_close
                            on_release: root._close_popup()